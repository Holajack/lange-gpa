# Copy to .env.local and fill in — see docs/SETUP-BACKEND.md for the exact steps.
# All five may be left empty: the app builds and runs as a keyless local demo.

# Convex deployment URL, printed by `npx convex dev` (https://<name>.convex.cloud)
NEXT_PUBLIC_CONVEX_URL=
# Convex deployment id (dev:<name>) — `npx convex dev` writes this to .env.local itself
CONVEX_DEPLOYMENT=
# Clerk publishable key (pk_test_... / pk_live_...) from Clerk dashboard → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (sk_test_... / sk_live_...) — server-side only, never commit
CLERK_SECRET_KEY=
# ElevenLabs API key for generating mascot voice cues (audio generation scripts)
ELEVENLABS_API_KEY=
